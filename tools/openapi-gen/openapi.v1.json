{
  "components": {
    "schemas": {
      "ProblemDetails": {
        "properties": {
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "format": "int32",
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "type": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "type": "object"
      },
      "ResendCodeResponse": {
        "description": "What a resend answers: how long to wait before asking again.",
        "properties": {
          "resendAfterSeconds": {
            "description": "Whole seconds.",
            "format": "int32",
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ]
          }
        },
        "required": [
          "resendAfterSeconds"
        ],
        "type": "object"
      },
      "SessionResponse": {
        "description": "What a started or refreshed session hands to the client; the refresh token travels in a cookie, never here.",
        "properties": {
          "accessToken": {
            "description": "The 15-minute bearer token. A secret.",
            "type": "string"
          },
          "accessTokenExpiresAt": {
            "description": "When the access token expires.",
            "format": "date-time",
            "type": "string"
          },
          "persistent": {
            "description": "True for \"Keep me signed in\".",
            "type": "boolean"
          },
          "sessionExpiresAt": {
            "description": "The fixed end of the session.",
            "format": "date-time",
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/SessionUser",
            "description": "The signed-in user."
          }
        },
        "required": [
          "accessToken",
          "accessTokenExpiresAt",
          "sessionExpiresAt",
          "persistent",
          "user"
        ],
        "type": "object"
      },
      "SessionUser": {
        "description": "The signed-in user as the client sees it.",
        "properties": {
          "email": {
            "description": "The sign-in email.",
            "type": "string"
          },
          "firstName": {
            "description": "Given name.",
            "type": "string"
          },
          "id": {
            "description": "The account id.",
            "format": "uuid",
            "type": "string"
          },
          "lastName": {
            "description": "Family name.",
            "type": "string"
          },
          "role": {
            "description": "The role, `Admin` or `Manager`.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "firstName",
          "lastName",
          "role"
        ],
        "type": "object"
      },
      "SignInRequest": {
        "description": "The sign-in form: email, password and the \"keep me signed in\" choice (D-03).",
        "properties": {
          "email": {
            "description": "The email address.",
            "type": [
              "null",
              "string"
            ]
          },
          "keepSignedIn": {
            "description": "True for a 90-day session, false for a browser session.",
            "type": "boolean"
          },
          "password": {
            "description": "The password, exactly as typed.",
            "type": [
              "null",
              "string"
            ]
          }
        },
        "required": [
          "email",
          "password",
          "keepSignedIn"
        ],
        "type": "object"
      },
      "SignInResponse": {
        "description": "What a successful sign-in step answers: how long to wait before asking for a new code.",
        "properties": {
          "resendAfterSeconds": {
            "description": "Whole seconds.",
            "format": "int32",
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ]
          }
        },
        "required": [
          "resendAfterSeconds"
        ],
        "type": "object"
      },
      "SiteSettingsDto": {
        "description": "The site settings as the API returns them (D-29). Read-only for now; editing comes later.",
        "properties": {
          "addressLine": {
            "description": "Public shop address.",
            "type": "string"
          },
          "businessName": {
            "description": "The business name shown on the site.",
            "type": "string"
          },
          "contactEmail": {
            "description": "Public contact email.",
            "type": "string"
          },
          "contactPhone": {
            "description": "Public contact phone.",
            "type": "string"
          },
          "currencyCode": {
            "description": "ISO 4217 currency code.",
            "type": "string"
          },
          "facebookUrl": {
            "description": "Public Facebook page URL.",
            "type": "string"
          },
          "locale": {
            "description": "Formatting locale.",
            "type": "string"
          },
          "rowVersion": {
            "description": "Base64 concurrency token, echoed back by a future edit (409 on conflict).",
            "type": "string"
          },
          "timeZoneId": {
            "description": "The business time zone id.",
            "type": "string"
          }
        },
        "required": [
          "businessName",
          "timeZoneId",
          "currencyCode",
          "locale",
          "contactEmail",
          "contactPhone",
          "addressLine",
          "facebookUrl",
          "rowVersion"
        ],
        "type": "object"
      },
      "VerifyCodeRequest": {
        "description": "The code step form: the six digits from the email (AUTH-02).",
        "properties": {
          "code": {
            "description": "The code, exactly as typed.",
            "type": [
              "null",
              "string"
            ]
          }
        },
        "required": [
          "code"
        ],
        "type": "object"
      },
      "VerifyCodeResponse": {
        "description": "What a correct code answers: the next step and, when signed in, the session.",
        "properties": {
          "next": {
            "description": "Either `signed-in` or `set-new-password`.",
            "type": "string"
          },
          "reason": {
            "description": "Why a new password is needed (`temporary` or `breach`); null when signed in.",
            "type": [
              "null",
              "string"
            ]
          },
          "session": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/SessionResponse",
                "description": "The started session; null when a new password is needed."
              }
            ]
          }
        },
        "required": [
          "next",
          "reason",
          "session"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Csps.Server | v1",
    "version": "1.0.0"
  },
  "openapi": "3.1.1",
  "paths": {
    "/api/v1/auth/refresh": {
      "post": {
        "operationId": "Refresh",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            },
            "description": "OK"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Forbidden"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Conflict"
          }
        },
        "summary": "Renews the access token with the refresh cookie and rotates the cookie.",
        "tags": [
          "AuthSession"
        ]
      }
    },
    "/api/v1/auth/sign-in": {
      "post": {
        "operationId": "SignIn",
        "requestBody": {
          "content": {
            "application/*+json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/components/schemas/SignInRequest"
                  }
                ]
              }
            },
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/components/schemas/SignInRequest"
                  }
                ]
              }
            },
            "text/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/components/schemas/SignInRequest"
                  }
                ]
              }
            }
          },
          "description": "Cancels the request."
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignInResponse"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Unauthorized"
          }
        },
        "summary": "Checks the email and password and sends the sign-in code.",
        "tags": [
          "SignIn"
        ]
      }
    },
    "/api/v1/auth/sign-out": {
      "post": {
        "operationId": "SignOut",
        "responses": {
          "204": {
            "content": {
              "application/json": {}
            },
            "description": "No Content"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Forbidden"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Conflict"
          }
        },
        "summary": "Ends this device's session and clears the refresh cookie. It succeeds with no cookie too.",
        "tags": [
          "AuthSession"
        ]
      }
    },
    "/api/v1/auth/sign-out-others": {
      "post": {
        "operationId": "SignOutOthers",
        "responses": {
          "204": {
            "content": {
              "application/json": {}
            },
            "description": "No Content"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Unauthorized"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Conflict"
          }
        },
        "summary": "Ends every other session of the signed-in user and keeps this one. It succeeds when there is nothing to end.",
        "tags": [
          "AuthSession"
        ]
      }
    },
    "/api/v1/auth/two-factor/resend": {
      "post": {
        "operationId": "ResendCode",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResendCodeResponse"
                }
              }
            },
            "description": "OK"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Forbidden"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Too Many Requests"
          }
        },
        "summary": "Sends a new sign-in code for the pending ticket, after the cooldown and within the hourly cap.",
        "tags": [
          "SignIn"
        ]
      }
    },
    "/api/v1/auth/two-factor/verify": {
      "post": {
        "operationId": "VerifyCode",
        "requestBody": {
          "content": {
            "application/*+json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/components/schemas/VerifyCodeRequest"
                  }
                ]
              }
            },
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/components/schemas/VerifyCodeRequest"
                  }
                ]
              }
            },
            "text/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/components/schemas/VerifyCodeRequest"
                  }
                ]
              }
            }
          },
          "description": "Cancels the request."
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerifyCodeResponse"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Forbidden"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Too Many Requests"
          }
        },
        "summary": "Checks the emailed code and starts the session, or hands over to the set-new-password step.",
        "tags": [
          "SignIn"
        ]
      }
    },
    "/api/v1/site-settings": {
      "get": {
        "operationId": "GetSiteSettings",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SiteSettingsDto"
                }
              }
            },
            "description": "The settings, or the failure as ProblemDetails."
          }
        },
        "summary": "Returns the site settings.",
        "tags": [
          "SiteSettings"
        ]
      }
    }
  },
  "servers": [
    {
      "url": "https://localhost/"
    }
  ],
  "tags": [
    {
      "name": "AuthSession"
    },
    {
      "name": "SignIn"
    },
    {
      "name": "SiteSettings"
    }
  ]
}
