save-exact=true
engine-strict=true
min-release-age=14
# Owner waiver D-11 (2026-10-07): lucide-react follows the newest stable release; the 14-day cool-down is waived.
min-release-age-exclude[]=lucide-react
# Security fix GHSA-rq7h-c2jc-7f22, GHSA-vfpm-58rq-9qcg, GHSA-9jrq-w75r-8gcw (vite 8.3.3), owner-approved D-25.
min-release-age-exclude[]=vite
# Security fix GHSA-68fv-2mgg-jv7q (high), owner-approved 2026-10-07: source-map-js 1.2.2, pinned in package.json overrides.
min-release-age-exclude[]=source-map-js
# Security fix GHSA-ch52-4w7c-c8xp (high), owner-approved 2026-10-07: http-cache-semantics 4.3.0, pinned in package.json overrides.
min-release-age-exclude[]=http-cache-semantics
# rolldown 1.2.11 owner waiver 2026-10-07, vite 8.3.3 engine (published 2026-09-24, 11.5 hours short of 14 days).
# Pinned to exactly 1.2.11 in package.json overrides, with its platform bindings; 1.2.12+ is not approved.
min-release-age-exclude[]=rolldown
min-release-age-exclude[]=@rolldown/binding-android-arm-eabi
min-release-age-exclude[]=@rolldown/binding-android-arm64
min-release-age-exclude[]=@rolldown/binding-darwin-arm64
min-release-age-exclude[]=@rolldown/binding-darwin-x64
min-release-age-exclude[]=@rolldown/binding-freebsd-x64
min-release-age-exclude[]=@rolldown/binding-linux-arm-gnueabihf
min-release-age-exclude[]=@rolldown/binding-linux-arm64-gnu
min-release-age-exclude[]=@rolldown/binding-linux-arm64-musl
min-release-age-exclude[]=@rolldown/binding-linux-ppc64-gnu
min-release-age-exclude[]=@rolldown/binding-linux-s390x-gnu
min-release-age-exclude[]=@rolldown/binding-linux-x64-gnu
min-release-age-exclude[]=@rolldown/binding-linux-x64-musl
min-release-age-exclude[]=@rolldown/binding-openharmony-arm64
min-release-age-exclude[]=@rolldown/binding-win32-arm64-msvc
min-release-age-exclude[]=@rolldown/binding-win32-x64-msvc
