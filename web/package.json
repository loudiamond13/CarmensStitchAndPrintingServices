{
  "name": "csps-web",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15 <25",
    "npm": ">=11.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:e2e": "vite build --mode e2e",
    "build:budget": "vite build --mode budget",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json && tsc -p tsconfig.reference.json",
    "lint": "eslint . --max-warnings 0",
    "audit:check": "node scripts/audit-gate.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "node scripts/verify.mjs",
    "e2e": "node scripts/e2e.mjs",
    "parity": "node scripts/parity.mjs",
    "lighthouse": "node scripts/lighthouse.mjs",
    "license:check": "node scripts/license-gate.mjs",
    "notices": "node scripts/third-party-notices.mjs --write",
    "notices:check": "node scripts/third-party-notices.mjs --check",
    "review": "node scripts/owner-review.mjs"
  },
  "overrides": {
    "axe-core": "4.14.0",
    "http-cache-semantics": "4.3.0",
    "source-map-js": "1.2.2",
    "zod": "4.6.7"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "@hookform/resolvers": "5.9.2",
    "@tanstack/react-query": "5.104.3",
    "clsx": "2.1.1",
    "lucide-react": "1.59.0",
    "nuqs": "2.10.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.90.0",
    "react-router": "8.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@babel/core": "8.0.7",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@rolldown/plugin-babel": "0.2.4",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/babel__core": "7.20.5",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "axe-core": "4.14.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-better-tailwindcss": "4.9.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "license-checker-rseidelsohn": "5.0.1",
    "lighthouse": "13.5.0",
    "msw": "3.0.3",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
