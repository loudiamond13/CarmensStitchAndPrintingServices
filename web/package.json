{
  "name": "csps-web",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15 <25",
    "npm": ">=11.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "node scripts/e2e.mjs",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test:coverage && npm run build"
  },
  "overrides": {
    "@rolldown/binding-android-arm-eabi": "1.2.11",
    "@rolldown/binding-android-arm64": "1.2.11",
    "@rolldown/binding-darwin-arm64": "1.2.11",
    "@rolldown/binding-darwin-x64": "1.2.11",
    "@rolldown/binding-freebsd-x64": "1.2.11",
    "@rolldown/binding-linux-arm-gnueabihf": "1.2.11",
    "@rolldown/binding-linux-arm64-gnu": "1.2.11",
    "@rolldown/binding-linux-arm64-musl": "1.2.11",
    "@rolldown/binding-linux-ppc64-gnu": "1.2.11",
    "@rolldown/binding-linux-s390x-gnu": "1.2.11",
    "@rolldown/binding-linux-x64-gnu": "1.2.11",
    "@rolldown/binding-linux-x64-musl": "1.2.11",
    "@rolldown/binding-openharmony-arm64": "1.2.11",
    "@rolldown/binding-win32-arm64-msvc": "1.2.11",
    "@rolldown/binding-win32-x64-msvc": "1.2.11",
    "axe-core": "4.13.0",
    "http-cache-semantics": "4.3.0",
    "rolldown": "1.2.11",
    "source-map-js": "1.2.2"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "@tanstack/react-query": "5.103.2",
    "clsx": "2.1.1",
    "lucide-react": "1.52.0",
    "nuqs": "2.10.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@babel/core": "7.29.7",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@rolldown/plugin-babel": "0.2.4",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/babel__core": "7.20.5",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.1",
    "axe-core": "4.13.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "jsdom": "30.1.1",
    "license-checker-rseidelsohn": "5.0.1",
    "lighthouse": "13.5.0",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.3",
    "vitest": "5.0.1"
  }
}
