<Project Sdk="Microsoft.NET.Sdk">

  <!-- Unit tests of the Application use cases, with NSubstitute fakes for the ports (coverage target 95%). -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Csps.Application\Csps.Application.csproj" />
  </ItemGroup>

  <!-- The synthetic photo builders have no dependencies, so the sniffer tests share the one source file with the endpoint tests. -->
  <ItemGroup>
    <Compile Include="..\Csps.Testing\Images\SyntheticImages.cs" Link="Images\SyntheticImages.cs" />
  </ItemGroup>

  <!-- The page names (D-69, D-75) are shared with the web node test and linked, never copied. -->
  <ItemGroup>
    <Content Include="..\fixtures\page-names.json" Link="Fixtures\page-names.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.Testing" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <!-- Coverage under Microsoft.Testing.Platform (D-17); thresholds are enforced by tools/scripts/Invoke-CoverageGate.ps1. -->
  <ItemGroup>
    <PackageReference Include="coverlet.MTP" />
  </ItemGroup>

</Project>
