<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared test library (fixtures, factories). Not a test project itself. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Csps.Server\Csps.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="xunit.v3.extensibility.core" />
    <PackageReference Include="Testcontainers.MsSql" />
    <PackageReference Include="Respawn" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.Testing" />
  </ItemGroup>

  <!-- The stub web root every test host serves (CspsApiFactory.FixtureWebRoot), so tests never need `npm run build`. -->
  <ItemGroup>
    <None Include="Fixtures\webroot\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
