{
  "version": 1,
  "kind": "csps-password-policy-cases",
  "messages": {
    "empty": "Enter a new password.",
    "too-short": "Use at least 8 characters.",
    "too-long": "Use 64 characters or fewer.",
    "control-character": "Remove tabs and line breaks from your password.",
    "no-number": "Add at least one number.",
    "no-symbol": "Add at least one symbol, like ! or #.",
    "contains-personal-info": "Don't use your name or email in your password."
  },
  "cases": [
    { "id": "empty", "note": "an empty password", "password": "", "personal": null, "mode": "composition", "expected": "empty" },
    { "id": "seven-chars", "note": "seven characters is one short", "password": "Abc12!x", "personal": null, "mode": "composition", "expected": "too-short" },
    { "id": "eight-chars", "note": "eight characters is the minimum", "password": "Abcd12!x", "personal": null, "mode": "composition", "expected": "ok" },
    { "id": "sixty-four-chars", "note": "64 characters is the maximum", "password": "Abcd12!xaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "personal": null, "mode": "composition", "expected": "ok" },
    { "id": "sixty-five-chars", "note": "65 characters is one too many", "password": "Abcd12!xaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "personal": null, "mode": "composition", "expected": "too-long" },
    { "id": "emoji-code-points", "note": "five emoji count as five, so eight code points pass", "password": "\ud83d\ude00\ud83d\ude00\ud83d\ude00\ud83d\ude00\ud83d\ude001!a", "personal": null, "mode": "composition", "expected": "ok" },
    { "id": "composed-e-acute", "note": "composed e-acute counts as one", "password": "Caf\u00e9-12!", "personal": null, "mode": "composition", "expected": "ok" },
    { "id": "decomposed-e-acute", "note": "decomposed e-acute counts as one after NFC", "password": "Cafe\u0301-12!", "personal": null, "mode": "composition", "expected": "ok" },
    { "id": "decomposed-short", "note": "a short decomposed password is still short", "password": "Cafe\u0301-1", "personal": null, "mode": "composition", "expected": "too-short" },
    { "id": "no-number", "note": "no digit", "password": "Password!", "personal": null, "mode": "composition", "expected": "no-number" },
    { "id": "no-symbol", "note": "no symbol", "password": "Password1", "personal": null, "mode": "composition", "expected": "no-symbol" },
    { "id": "space-is-not-a-symbol", "note": "a space is not a symbol", "password": "Pass word1", "personal": null, "mode": "composition", "expected": "no-symbol" },
    { "id": "space-allowed", "note": "spaces are allowed", "password": "Pass word1!", "personal": null, "mode": "composition", "expected": "ok" },
    { "id": "arabic-indic-digit", "note": "a Unicode Nd digit counts as a number", "password": "Passw\u0660rd!", "personal": null, "mode": "composition", "expected": "ok" },
    { "id": "euro-symbol", "note": "the euro sign is a symbol (Sc)", "password": "Pass\u20acword1", "personal": null, "mode": "composition", "expected": "ok" },
    { "id": "emoji-symbol", "note": "an emoji is a symbol (So)", "password": "Password1\ud83d\ude00", "personal": null, "mode": "composition", "expected": "ok" },
    { "id": "tab", "note": "a tab is refused", "password": "Abc\tdef1!", "personal": null, "mode": "composition", "expected": "control-character" },
    { "id": "line-break", "note": "a line break is refused", "password": "Abc\ndef1!", "personal": null, "mode": "composition", "expected": "control-character" },
    { "id": "eight-spaces", "note": "eight spaces pass the length rule and fail on the number", "password": "        ", "personal": null, "mode": "composition", "expected": "no-number" },
    { "id": "short-beats-control", "note": "too short wins over a control character", "password": "a\t", "personal": null, "mode": "composition", "expected": "too-short" },
    { "id": "control-beats-number", "note": "a control character wins over a missing number", "password": "Abcdefgh!\t", "personal": null, "mode": "composition", "expected": "control-character" },
    { "id": "number-beats-symbol", "note": "a missing number is reported before a missing symbol", "password": "Password", "personal": null, "mode": "composition", "expected": "no-number" },
    { "id": "personal-first-name", "note": "first name inside the password", "password": "Paolo#2026x", "personal": {"email":"paolo.garcia@gmail.com","firstName":"Paolo","lastName":"Garcia"}, "mode": "full", "expected": "contains-personal-info" },
    { "id": "personal-last-name-upper", "note": "last name in another case", "password": "xx-GARCIA-9!", "personal": {"email":"paolo.garcia@gmail.com","firstName":"Paolo","lastName":"Garcia"}, "mode": "full", "expected": "contains-personal-info" },
    { "id": "personal-email-local", "note": "the email local part", "password": "paolo.garcia#1", "personal": {"email":"paolo.garcia@gmail.com","firstName":"Paolo","lastName":"Garcia"}, "mode": "full", "expected": "contains-personal-info" },
    { "id": "personal-composition-mode", "note": "composition mode ignores personal information", "password": "Paolo#2026x", "personal": {"email":"paolo.garcia@gmail.com","firstName":"Paolo","lastName":"Garcia"}, "mode": "composition", "expected": "ok" },
    { "id": "personal-clean-full", "note": "a clean password in full mode", "password": "Tela-Sukat-7381", "personal": {"email":"paolo.garcia@gmail.com","firstName":"Paolo","lastName":"Garcia"}, "mode": "full", "expected": "ok" },
    { "id": "personal-short-name-ignored", "note": "a two-character first name blocks nothing", "password": "Al#12345", "personal": {"email":"al@example.com","firstName":"Al","lastName":null}, "mode": "full", "expected": "ok" },
    { "id": "personal-three-char-name-blocks", "note": "a three-character first name blocks", "password": "xxAnaxx#1", "personal": {"email":"ana.lim@example.com","firstName":"Ana","lastName":null}, "mode": "full", "expected": "contains-personal-info" },
    { "id": "personal-spaced-last-name", "note": "a last name with a space is matched as written", "password": "DelaCruz#1", "personal": {"email":"x@example.com","firstName":null,"lastName":"Dela Cruz"}, "mode": "full", "expected": "ok" },
    { "id": "personal-spaced-last-name-exact", "note": "a last name with a space blocks when typed with the space", "password": "Dela Cruz#1", "personal": {"email":"x@example.com","firstName":null,"lastName":"Dela Cruz"}, "mode": "full", "expected": "contains-personal-info" },
    { "id": "personal-short-wins", "note": "too short wins over personal information by order", "password": "paolo", "personal": {"email":"paolo.garcia@gmail.com","firstName":"Paolo","lastName":"Garcia"}, "mode": "full", "expected": "too-short" },
    { "id": "personal-no-number-wins", "note": "a missing number wins over personal information by order", "password": "paolo-garcia", "personal": {"email":"paolo.garcia@gmail.com","firstName":"Paolo","lastName":"Garcia"}, "mode": "full", "expected": "no-number" },
    { "id": "personal-composed-name", "note": "a decomposed name matches a composed password", "password": "x-Jos\u00e9-12!", "personal": {"email":"jose@example.com","firstName":"Jose\u0301","lastName":null}, "mode": "full", "expected": "contains-personal-info" },
    { "id": "personal-email-first-at-only", "note": "the local part is the text before the last @, not the first", "password": "xxabc#12!", "personal": {"email":"abc@def@example.com","firstName":null,"lastName":null}, "mode": "full", "expected": "ok" },
    { "id": "personal-email-last-at-blocks", "note": "the full text before the last @ blocks", "password": "xxabc@def#1", "personal": {"email":"abc@def@example.com","firstName":null,"lastName":null}, "mode": "full", "expected": "contains-personal-info" },
    { "id": "personal-email-without-at", "note": "an address without @ is used whole", "password": "xpaolo#12", "personal": {"email":"paolo","firstName":null,"lastName":null}, "mode": "full", "expected": "contains-personal-info" },
    { "id": "personal-email-empty-local", "note": "an empty local part blocks nothing", "password": "Abcd12!x", "personal": {"email":"@example.com","firstName":null,"lastName":null}, "mode": "full", "expected": "ok" },
    { "id": "personal-blank-parts", "note": "blank names are ignored", "password": "Abcd12!x", "personal": {"email":"paolo@example.com","firstName":"   ","lastName":""}, "mode": "full", "expected": "ok" }
  ]
}
