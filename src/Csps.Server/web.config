<?xml version="1.0" encoding="utf-8"?>
<!-- IIS hosting for SmarterASP.NET (SEC-01, OPS-05). The app does the HTTPS redirect, HSTS, compression and caching; IIS hosts in-process, hides banners, limits bodies and never compresses. -->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\Csps.Server.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
      <security>
        <requestFiltering removeServerHeader="true">
          <requestLimits maxAllowedContentLength="1048576" />
        </requestFiltering>
      </security>
      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>
      <!-- OPS-05: the app compresses html, css, js and svg and never JSON (BREACH); IIS must not compress again. -->
      <urlCompression doStaticCompression="false" doDynamicCompression="false" />
    </system.webServer>
  </location>
</configuration>
