{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "CspsLogging": {
    "WriteToFile": true
  },
  "Jwt": {
    "Issuer": "csps",
    "Audience": "csps-api"
  },
  "AllowedHosts": "*"
}
