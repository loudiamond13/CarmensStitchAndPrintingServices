<Project Sdk="Microsoft.NET.Sdk">

  <!-- QUAL-05: the Testing email sink is compiled into Debug builds only, so a Release build cannot contain it. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DefineConstants>$(DefineConstants);CSPS_TESTING</DefineConstants>
  </PropertyGroup>

  <!-- The SecLists top-10k common passwords (MIT), pinned by hash in docs/dependencies.json (D-14, D-36). -->
  <ItemGroup>
    <EmbeddedResource Include="Passwords\common-passwords-10k.txt" LogicalName="Csps.Infrastructure.Passwords.common-passwords-10k.txt" />
  </ItemGroup>

  <!-- The 2x PNG of the horizontal CSPS lockup the auth emails attach inline (D-30); made by web/scripts/render-email-logo.mjs. -->
  <ItemGroup>
    <EmbeddedResource Include="Email\Assets\csps-logo.png" LogicalName="Csps.Infrastructure.Email.Assets.csps-logo.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Csps.Application\Csps.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Csps.Infrastructure.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Health checks and the Data Protection builder live in the shared framework. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="MailKit" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
  </ItemGroup>

</Project>
