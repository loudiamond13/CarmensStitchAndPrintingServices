#!/bin/sh
# D-10: scan the staged changes for secrets before the commit is made.
# Enable once with: powershell -NoProfile -ExecutionPolicy Bypass -File tools/scripts/Install-Gitleaks.ps1 -SetHooksPath

root=$(git rev-parse --show-toplevel) || exit 0
cd "$root" || exit 0

# Nothing staged: nothing to scan.
if git diff --cached --quiet; then
  exit 0
fi

# Use the pinned local install first, then gitleaks on PATH.
local_bin="artifacts/tools/gitleaks/8.30.1/gitleaks.exe"
if [ -x "$local_bin" ]; then
  gitleaks() { "$local_bin" "$@"; }
elif command -v gitleaks >/dev/null 2>&1; then
  :
else
  echo "pre-commit: gitleaks is not installed, so the staged changes were NOT scanned for secrets." >&2
  echo "pre-commit: run tools/scripts/Install-Gitleaks.ps1 to install it." >&2
  exit 0
fi

gitleaks git --pre-commit --staged --redact --config .gitleaks.toml --no-banner
exit $?
